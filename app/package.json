{
  "name": "qparking-local",
  "productName": "QParking Local Server",
  "version": "0.19.0",
  "description": "On-prem parking controller: LPR camera ingest, ECPI payment-terminal driver, parking-session state machine, rate sync from qparking SaaS.",
  "main": "dist/main/index.js",
  "author": "QParking",
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dev": "concurrently -k -n vite,electron -c blue,yellow \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p src/main/tsconfig.json && node scripts/dev-electron.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "node scripts/clean-main.mjs && tsc -p src/main/tsconfig.json",
    "package": "npm run build && electron-builder --win nsis portable",
    "package:portable": "npm run build && electron-builder --win portable",
    "publish:cloud": "node scripts/publish.mjs",
    "ship": "npm run package && node scripts/publish.mjs",
    "lint": "tsc -p src/main/tsconfig.json --noEmit && tsc -p src/renderer/tsconfig.json --noEmit",
    "test:migration": "npm run build:main && node tools/migration-check/run.mjs",
    "test:fees": "npm run build:main && node tools/fee-gap-check/run.mjs",
    "test": "npm run test:migration && npm run test:fees && npm run test:gate && npm run test:parity && npm run test:sessions && npm run test:activity && npm run test:session-sync && npm run test:relay-latency",
    "find:cameras": "node tools/find-cameras/run.mjs",
    "test:gate": "npm run build:main && node tools/gate-guard-check/run.mjs",
    "test:sessions": "npm run build:main && node tools/session-suite/run.mjs",
    "test:activity": "npm run build:main && node tools/activity-log-check/run.mjs",
    "test:session-sync": "npm run build:main && node tools/session-sync-check/run.mjs",
    "test:relay-latency": "npm run build:main && node tools/relay-latency-check/run.mjs",
    "test:parity": "npm run build:main && node tools/gate-parity-check/run.mjs"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "better-sqlite3": "^11.3.0",
    "ffmpeg-static": "^5.3.0",
    "koffi": "^3.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.5",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.45",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.qparking.local",
    "productName": "QParking Local Server",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/vzsdk",
        "to": "native/vzsdk"
      }
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**",
      "**/node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "QParkingLocal-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QParking Local",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "QParkingLocal-${version}-portable.exe"
    }
  }
}
